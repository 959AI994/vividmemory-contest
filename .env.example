# Contest-friendly aliases (mapped to VividMemory env vars in docker-compose.yml)
# Official evaluators: fill in BOTH keys below before `docker compose up`.
#   1) LLM_API_KEY        — fact extraction on /add
#   2) EMBEDDINGS_API_KEY — OpenAI embeddings for indexing + recall (recommended)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=YOUR_LLM_API_KEY_HERE
LLM_BASE_URL=https://api.openai.com/v1

# Embeddings — official runs should use a strong OpenAI embeddings model.
# Fallback only if you have no embeddings API:
#   EMBEDDINGS_PROVIDER=onnx
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-large
EMBEDDINGS_API_KEY=YOUR_OPENAI_EMBEDDINGS_API_KEY_HERE
EMBEDDINGS_BASE_URL=https://api.openai.com/v1

# Local cross-encoder reranker (CPU). Image includes sentence-transformers.
RERANKER_PROVIDER=local
RERANKER_LOCAL_FORCE_CPU=true
RERANKER_LOCAL_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Database is provided by Compose service `db` (pgvector/pgvector:pg16).
# No DATABASE_URL is required in .env unless you override it in docker-compose.yml.

# Adapter behavior (max-quality contest profile)
ADAPTER_INCLUDE_OPTIONS_IN_QUERY=true
ADAPTER_RECALL_BUDGET=high
ADAPTER_RECALL_MAX_TOKENS=8192
ADAPTER_HTTP_TIMEOUT_SECONDS=3600

# ---------------------------------------------------------------------------
# Optional: DeepSeek / OpenAI-compatible gateway for local development
# ---------------------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_MODEL=deepseek-v4-pro
# LLM_API_KEY=your-key
# LLM_BASE_URL=https://api.deepseek.com/v1
# EMBEDDINGS_PROVIDER=openai
# EMBEDDINGS_MODEL=text-embedding-3-large
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# EMBEDDINGS_API_KEY=your-openai-embedding-key

# ---------------------------------------------------------------------------
# Benchmark evaluation (dev-local, NOT official)
# Answer model is used by the evaluation pipelines to produce responses.
# Judge model scores those responses. Both are independently configurable and
# never share credentials with LLM_*.
# ---------------------------------------------------------------------------
ANSWER_API_BASE=
ANSWER_API_KEY=
ANSWER_MODEL=
ANSWER_PROVIDER=openai

JUDGE_API_BASE=
JUDGE_API_KEY=
JUDGE_MODEL=
JUDGE_VERSION=
JUDGE_PROVIDER=openai

# ---------------------------------------------------------------------------
# Max-quality adapter / extraction defaults (quality prioritized over latency)
# ---------------------------------------------------------------------------
# Per-message retain: finer-grained memories (slower /add; timeout budget 3600s)
ADAPTER_PER_MESSAGE_RETAIN=true
ADAPTER_RETAIN_CONCURRENCY=8

# Contest custom extraction prompt (transitions / dates / quantities).
# When RETAIN_CUSTOM_INSTRUCTIONS is empty, the vividmemory image entrypoint
# loads vividmemory-api-slim/prompts/contest_transitions.txt automatically.
RETAIN_EXTRACTION_MODE=custom
RETAIN_CUSTOM_INSTRUCTIONS=

# Dual retrieval + options rewrite + near-dedup (LoCoMo holdout winners)
ADAPTER_RECALL_INCLUDE_OBSERVATIONS=true
ADAPTER_OPTIONS_IN_QUERY_MODE=rewrite
ADAPTER_NEAR_DEDUP_THRESHOLD=0.85

# Episode prepend measured as a regression on LoCoMo — keep disabled.
ADAPTER_EPISODE_PREPEND=false
ADAPTER_EPISODE_PREPEND_COUNT=2
