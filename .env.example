# Contest-friendly aliases (mapped to VividMemory env vars in docker-compose.yml)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1

# Embeddings (defaults to OpenAI using the same API key)
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_BASE_URL=

# Reranker: rrf = fusion order passthrough (no local neural model required)
RERANKER_PROVIDER=rrf

# Database is provided by Compose service `db` (pgvector/pgvector:pg16).
# No DATABASE_URL is required in .env unless you override it in docker-compose.yml.

# Adapter behavior
ADAPTER_INCLUDE_OPTIONS_IN_QUERY=true
ADAPTER_RECALL_BUDGET=high
ADAPTER_RECALL_MAX_TOKENS=8192

# ---------------------------------------------------------------------------
# Optional: DeepSeek / OpenAI-compatible gateway for local development
# ---------------------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_MODEL=deepseek-v4-pro
# LLM_API_KEY=your-key
# LLM_BASE_URL=https://api.deepseek.com/v1
# EMBEDDINGS_PROVIDER=openai
# EMBEDDINGS_MODEL=text-embedding-3-small
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# EMBEDDINGS_API_KEY=your-openai-embedding-key

# ---------------------------------------------------------------------------
# Benchmark evaluation (dev-local, NOT official)
# Answer model is used by the evaluation pipelines to produce responses.
# Judge model scores those responses. Both are independently configurable and
# never share credentials with LLM_*.
# ---------------------------------------------------------------------------
ANSWER_API_BASE=
ANSWER_API_KEY=
ANSWER_MODEL=
ANSWER_PROVIDER=openai

JUDGE_API_BASE=
JUDGE_API_KEY=
JUDGE_MODEL=
JUDGE_VERSION=
JUDGE_PROVIDER=openai

# ---------------------------------------------------------------------------
# Adapter feature flags (defaults preserve current behavior)
# ---------------------------------------------------------------------------
# Phase 1 — retain each contest message as its own document
ADAPTER_PER_MESSAGE_RETAIN=false
ADAPTER_RETAIN_CONCURRENCY=4

# Phase 2 — extraction mode: concise (default), verbose, or custom
RETAIN_EXTRACTION_MODE=concise
# When RETAIN_EXTRACTION_MODE=custom, this text is passed to the engine as
# additional extraction instructions. Loaded via Compose override from
# vividmemory-api-slim/prompts/contest_transitions.txt when active.
RETAIN_CUSTOM_INSTRUCTIONS=

# Phase 3 — dual retrieval: include raw episode / observation units in recall
ADAPTER_RECALL_INCLUDE_OBSERVATIONS=false
ADAPTER_EPISODE_PREPEND=false
ADAPTER_EPISODE_PREPEND_COUNT=2

# Phase 4 — reranker. Default stays 'rrf' (fusion passthrough) until Phase 4A
# lands; when set to 'local' the engine's cross-encoder is used.
# RERANKER_PROVIDER=rrf   # already documented above
RERANKER_LOCAL_FORCE_CPU=true
VIVIDMEMORY_API_RERANKER_LOCAL_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Phase 4B — how options are folded into the recall query. append (default),
# none, or rewrite (strip leading option letters like "A.", "(B)", "[c]:")
ADAPTER_OPTIONS_IN_QUERY_MODE=append

# Phase 4C — token-Jaccard near-duplicate collapse threshold (0.0 disables)
ADAPTER_NEAR_DEDUP_THRESHOLD=0.0
