# Contest-friendly aliases (mapped to VividMemory env vars in docker-compose.yml)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1

# Embeddings (defaults to OpenAI using the same API key)
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_BASE_URL=

# Reranker: rrf = fusion order passthrough (no local neural model required)
RERANKER_PROVIDER=rrf

# Adapter behavior
ADAPTER_INCLUDE_OPTIONS_IN_QUERY=true
ADAPTER_RECALL_BUDGET=high
ADAPTER_RECALL_MAX_TOKENS=8192

# ---------------------------------------------------------------------------
# Optional: DeepSeek / OpenAI-compatible gateway for local development
# ---------------------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_MODEL=deepseek-v4-pro
# LLM_API_KEY=your-key
# LLM_BASE_URL=https://api.deepseek.com/v1
# EMBEDDINGS_PROVIDER=openai
# EMBEDDINGS_MODEL=text-embedding-3-small
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# EMBEDDINGS_API_KEY=your-openai-embedding-key
